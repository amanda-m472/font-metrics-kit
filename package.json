{
  "name": "font-metrics-kit",
  "version": "0.1.0",
  "description": "Measure text using real font metrics tables instead of string length.",
  "keywords": [
    "font",
    "font-metrics",
    "text-measurement",
    "typography",
    "kerning",
    "word-wrap",
    "sfnt",
    "afm",
    "hmtx"
  ],
  "author": "amanda-m472",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./sfnt": {
      "types": "./dist/src/sfnt.d.ts",
      "default": "./dist/src/sfnt.js"
    },
    "./afm": {
      "types": "./dist/src/afm.d.ts",
      "default": "./dist/src/afm.js"
    },
    "./wrap": {
      "types": "./dist/src/wrap.d.ts",
      "default": "./dist/src/wrap.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
